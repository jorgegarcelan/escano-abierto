# Clave de la API de Gemini (https://aistudio.google.com/apikey): con ella se usa gemini-3.8-flash
GEMINI_API_KEY=
# O bien la de Anthropic (https://console.anthropic.com), si no hay clave de Gemini
ANTHROPIC_API_KEY=sk-ant-...
# Modelo para resúmenes y tono (opcional; por defecto gemini-3.8-flash o claude-sonnet-4-5)
ESCANO_MODELO=
# Dirección pública de la web, para las imágenes y enlaces de las páginas para compartir (opcional en local)
ESCANO_URL_SITIO=
