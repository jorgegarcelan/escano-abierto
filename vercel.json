{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "sh scripts/vercel-build.sh",
  "outputDirectory": "site",
  "redirects": [
    {
      "source": "/",
      "destination": "https://reforma-digital.es/congreso",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://reforma-digital.es/congreso/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|datos/|og/|_vercel/)[^.]*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
